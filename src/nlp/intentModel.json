            "printer",
            "restaurant",
            "restroom",
            "room"
          ]
        },
        "maxItems": 4
      },
      "nearest": { "type": "boolean" },
      "currentInfo": { "type": "boolean" }
    },
    "required": [
      "dest",
      "origin",
      "waypoints",
      "mode",
      "mandatory",
      "preferences",
      "timeLimitMin",
      "unsupported",
