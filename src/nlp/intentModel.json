            "room"
          ]
        },
        "maxItems": 4
      },
      "needs": { "type": "array", "items": { "type": "string" }, "maxItems": 4 },
      "secondaryModes": {
        "type": "array",
        "items": { "enum": ["shortest", "fastest", "avoidStairs", "accessible", "preferElevator", "rainProtected", "nightSafe"] },
        "maxItems": 4
      },
      "excludedNames": { "type": "array", "items": { "type": "string" }, "maxItems": 4 },
      "excludedCategories": {
        "type": "array",
        "items": {
          "enum": [
            "bus_stop",
            "cafe",
            "cafeteria",
            "classroom",
            "convenience_store",
