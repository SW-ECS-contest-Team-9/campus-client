{
  "schema": {
    "type": "object",
    "properties": {
      "dest": {
        "type": "object",
        "properties": { "name": { "type": ["string", "null"] }, "floor": { "type": ["string", "null"] } },
        "required": ["name", "floor"],
        "additionalProperties": false
      },
      "origin": {
        "type": "object",
        "properties": { "current": { "type": "boolean" }, "name": { "type": ["string", "null"] }, "floor": { "type": ["string", "null"] } },
        "required": ["current", "name", "floor"],
        "additionalProperties": false
      },
      "waypoints": { "type": "array", "items": { "type": "string" }, "maxItems": 4 },
      "mode": { "enum": ["shortest", "fastest", "avoidStairs", "accessible", "preferElevator", "rainProtected", "nightSafe"] },
      "mandatory": { "type": "array", "items": { "enum": ["avoidStairs", "wheelchairNeeded"] }, "maxItems": 4 },
      "preferences": { "type": "array", "items": { "enum": ["indoor", "fewerStairs"] }, "maxItems": 4 },
      "timeLimitMin": { "type": ["integer", "null"] },
      "unsupported": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": { "text": { "type": "string" }, "reason": { "type": "string" } },
          "required": ["text", "reason"],
          "additionalProperties": false
        },
        "maxItems": 0
      },
      "clarify": { "type": ["string", "null"] },
      "kind": { "enum": ["place", "category", "need", "person", "unknown"] },
      "categories": {
        "type": "array",
        "items": {
          "enum": [
